<Window x:Class="ProyectoFDP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MatrixCrypt · Hill Cipher"
        Height="720" Width="1140"
        MinHeight="600" MinWidth="960"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>

        <!--  ===== Paleta de degradados azules técnicos ===== -->
        <LinearGradientBrush x:Key="FondoApp" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1622" Offset="0"/>
            <GradientStop Color="#132A45" Offset="0.55"/>
            <GradientStop Color="#1B3B5C" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="Sidebar" Color="#0D1B2A" Opacity="0.92"/>
        <SolidColorBrush x:Key="TitleBar" Color="#08121C"/>

        <LinearGradientBrush x:Key="AccentInicio" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0F2027" Offset="0"/>
            <GradientStop Color="#2C5364" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentEncriptar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0093E9" Offset="0"/>
            <GradientStop Color="#4FC3E8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentDesencriptar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1B2A63" Offset="0"/>
            <GradientStop Color="#2E63A8" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentVerificar" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0064B5" Offset="0"/>
            <GradientStop Color="#00D4E0" Offset="1"/>
        </LinearGradientBrush>

        <SolidColorBrush x:Key="TextoPrincipal" Color="#EAF2FA"/>
        <SolidColorBrush x:Key="TextoSecundario" Color="#8FA6BC"/>
        <SolidColorBrush x:Key="Tarjeta" Color="#12233A"/>
        <SolidColorBrush x:Key="TarjetaBorde" Color="#24466B"/>

        <!--  ===== Estilo item de menu lateral ===== -->
        <Style x:Key="NavItemStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicador" Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{StaticResource AccentVerificar}" Opacity="0" Margin="-14,4,0,4"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#16304A"/>
                                <Setter TargetName="Indicador" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#122844"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ===== Boton primario con degradado dinamico (se define el color via Tag/Background al usar) ===== -->
        <Style x:Key="BotonAccion" TargetType="Button">
            <Setter Property="Foreground" Value="#08121C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ===== Boton de titlebar (minimizar / cerrar) ===== -->
        <Style x:Key="BotonVentana" TargetType="Button">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextoSecundario}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1B3B5C"/>
                                <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  ===== TextBox estilo tarjeta ===== -->
        <Style x:Key="CajaTexto" TargetType="TextBox">
            <Setter Property="Background" Value="#0E1E33"/>
            <Setter Property="Foreground" Value="{StaticResource TextoPrincipal}"/>
            <Setter Property="CaretBrush" Value="#4FC3E8"/>
            <Setter Property="BorderBrush" Value="{StaticResource TarjetaBorde}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!--  ===== Contenedor con borde redondeado y sombra ===== -->
    <Border CornerRadius="16" Background="{StaticResource FondoApp}" BorderBrush="#24466B" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.5" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!--  ===== Barra de titulo personalizada ===== -->
            <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource TitleBar}"
                    CornerRadius="16,16,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                        <Ellipse Width="10" Height="10" Fill="{StaticResource AccentVerificar}" Margin="0,0,10,0"/>
                        <TextBlock Text="MatrixCrypt" Foreground="{StaticResource TextoPrincipal}"
                                   FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  Cifrado por matrices (Hill Cipher)" Foreground="{StaticResource TextoSecundario}"
                                   FontSize="12" VerticalAlignment="Center" Margin="4,2,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#xE921;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BotonVentana}"
                                Click="Minimizar_Click" ToolTip="Minimizar"/>
                        <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" Style="{StaticResource BotonVentana}"
                                Click="Cerrar_Click" ToolTip="Cerrar"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--  ===== Sidebar ===== -->
            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource Sidebar}" Padding="16,20">
                <StackPanel>
                    <TextBlock Text="MENU" Foreground="{StaticResource TextoSecundario}" FontSize="11"
                               FontWeight="Bold" Margin="14,0,0,10"/>

                    <RadioButton x:Name="NavInicio" Content="Inicio" Tag="Inicio" IsChecked="True"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Click"/>
                    <RadioButton x:Name="NavEncriptar" Content="Encriptar" Tag="Encriptar"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Click"/>
                    <RadioButton x:Name="NavDesencriptar" Content="Desencriptar" Tag="Desencriptar"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Click"/>
                    <RadioButton x:Name="NavVerificar" Content="Verificar ida y vuelta" Tag="Verificar"
                                 Style="{StaticResource NavItemStyle}" Checked="Nav_Click"/>

                    <TextBlock Text="ALGORITMO" Foreground="{StaticResource TextoSecundario}" FontSize="11"
                               FontWeight="Bold" Margin="14,24,0,10"/>
                    <Border Background="#0E1E33" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Clave: matriz 3x3" Foreground="{StaticResource TextoPrincipal}" FontSize="12" FontWeight="SemiBold"/>
                            <TextBlock Text="Alfabeto: A-Z, Ñ, espacio" Foreground="{StaticResource TextoSecundario}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <StackPanel VerticalAlignment="Bottom" Margin="0,60,0,0">
                        <TextBlock Text="App v1.0" Foreground="{StaticResource TextoSecundario}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!--  ===== Area de contenido dinamico ===== -->
            <Grid Grid.Row="1" Grid.Column="1" Margin="28">

                
                <Grid x:Name="PanelInicio" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="Bienvenido a MatrixCrypt" Foreground="{StaticResource TextoPrincipal}" FontSize="24" FontWeight="Bold"/>
                        <TextBlock Text="Cifrado y descifrado de mensajes usando álgebra de matrices (Hill Cipher 3x3)."
                                   Foreground="{StaticResource TextoSecundario}" FontSize="13" Margin="0,6,0,0"/>
                    </StackPanel>

                    <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="0,0,0,10">
                        <Border Background="{StaticResource AccentEncriptar}" CornerRadius="12" Margin="0,0,8,0" Padding="18" Height="110">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Encriptar" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Texto → criptograma numérico" Foreground="#E7F6FF" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AccentDesencriptar}" CornerRadius="12" Margin="8,0" Padding="18" Height="110">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Desencriptar" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Criptograma → mensaje original" Foreground="#DCE7FF" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource AccentVerificar}" CornerRadius="12" Margin="8,0,0,0" Padding="18" Height="110">
                            <StackPanel VerticalAlignment="Bottom">
                                <TextBlock Text="Verificar" Foreground="White" FontSize="16" FontWeight="Bold"/>
                                <TextBlock Text="Prueba de ida y vuelta" Foreground="#DFFBFF" FontSize="11" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border Grid.Row="2" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="20" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="¿Cómo funciona?" Foreground="{StaticResource TextoPrincipal}" FontSize="15" FontWeight="SemiBold"/>
                            <TextBlock Foreground="{StaticResource TextoSecundario}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Cada letra del mensaje se convierte en un número, se agrupa en bloques de 3 y se multiplica por una matriz clave invertible de 3x3. El resultado es el criptograma. Para recuperar el mensaje se multiplica por la matriz inversa de la clave."/>
                        </StackPanel>
                    </Border>
                </Grid>

              
                <Grid x:Name="PanelEncriptar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource AccentEncriptar}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Encriptar mensaje" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Escribe el texto que quieres proteger" Foreground="#E7F6FF" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Mensaje" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="MensajeInput" Style="{StaticResource CajaTexto}" Height="90"/>
                            <Button Content="Encriptar" Style="{StaticResource BotonAccion}" Background="{StaticResource AccentEncriptar}"
                                    Width="160" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Encriptar_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="18" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Criptograma generado" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="CriptogramaOutput" Style="{StaticResource CajaTexto}" Height="90" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </Grid>

              
                <Grid x:Name="PanelDesencriptar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource AccentDesencriptar}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Desencriptar mensaje" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Pega el criptograma (números separados por espacio)" Foreground="#DCE7FF" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Criptograma" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="CriptogramaInput" Style="{StaticResource CajaTexto}" Height="90"/>
                            <Button Content="Desencriptar" Style="{StaticResource BotonAccion}" Background="{StaticResource AccentDesencriptar}"
                                    Foreground="White" Width="160" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Desencriptar_Click"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="18" Margin="0,18,0,0">
                        <StackPanel>
                            <TextBlock Text="Mensaje recuperado" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="MensajeOutput" Style="{StaticResource CajaTexto}" Height="90" IsReadOnly="True"/>
                        </StackPanel>
                    </Border>
                </Grid>

               
                <Grid x:Name="PanelVerificar" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource AccentVerificar}" CornerRadius="12" Padding="20" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="Verificar ida y vuelta" Foreground="White" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="Encripta y desencripta para comprobar que el algoritmo es reversible" Foreground="#DFFBFF" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="{StaticResource Tarjeta}" CornerRadius="12"
                            BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Mensaje" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBox x:Name="MensajeVerificarInput" Style="{StaticResource CajaTexto}" Height="70"/>
                            <Button Content="Encriptar y verificar" Style="{StaticResource BotonAccion}" Background="{StaticResource AccentVerificar}"
                                    Width="190" HorizontalAlignment="Left" Margin="0,14,0,0" Click="Verificar_Click"/>
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource Tarjeta}" CornerRadius="12"
                                BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Criptograma" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="CriptogramaVerificarOutput" Style="{StaticResource CajaTexto}" Height="80" IsReadOnly="True"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource Tarjeta}" CornerRadius="12"
                                BorderBrush="{StaticResource TarjetaBorde}" BorderThickness="1" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Mensaje recuperado" Foreground="{StaticResource TextoSecundario}" FontSize="12" Margin="0,0,0,6"/>
                                <TextBox x:Name="MensajeRecuperadoOutput" Style="{StaticResource CajaTexto}" Height="80" IsReadOnly="True"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="BadgeVerificacion" Grid.Row="3" HorizontalAlignment="Left"
                               FontSize="13" FontWeight="SemiBold" Margin="0,14,0,0"/>
                </Grid>

            </Grid>
        </Grid>
    </Border>
</Window>
